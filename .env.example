# ══════════════════════════════════════════════════════════════════
#   ShieldFlow — Variables de entorno
#   Copia este archivo como .env y rellena los valores
#   El .env NUNCA se sube a GitHub (está en el .gitignore)
# ══════════════════════════════════════════════════════════════════


# ── Aplicación ─────────────────────────────────────────────────────
# Nombre que aparece en los logs
APP_NAME=ShieldFlow

# Cambia a "production" cuando despliegues
APP_ENV=development

# En qué IP escucha el servidor (0.0.0.0 = todas las interfaces)
APP_HOST=0.0.0.0
APP_PORT=8000

# En true activa hot-reload y logs más verbosos. En producción pon false
DEBUG=true


# ── JWT — Tokens de autenticación ──────────────────────────────────
# IMPORTANTE: Genera una clave segura y no la compartas nunca
# Para generarla corre esto en tu terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-esto-antes-de-subir-a-produccion

# Algoritmo de firma. HS256 está bien para la mayoría de casos
JWT_ALGORITHM=HS256

# Cuántos minutos dura el access token antes de expirar
# 30 minutos es el estándar. Menos = más seguro, más fricción para el usuario
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cuántos días dura el refresh token
# Con esto el usuario no tiene que loguearse cada 30 minutos
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# ── Redis — Rate Limiting ───────────────────────────────────────────
# Local con Docker:   redis://localhost:6379
# Upstash (gratis):  rediss://default:CONTRASEÑA@HOST.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Solo si tu Redis tiene contraseña (Upstash la tiene)
REDIS_PASSWORD=


# ── Rate Limiting — Cuántas peticiones permite por cliente ──────────
# Cada IP/API Key tiene un "cubo" con esta cantidad de tokens
# Cada petición consume 1 token. Cuando se vacía → 429
RATE_LIMIT_REQUESTS=100

# Cada cuántos segundos se rellena el cubo por completo
RATE_LIMIT_WINDOW_SECONDS=60

# Capacidad extra para picos de tráfico cortos (no implementado aún, reservado)
RATE_LIMIT_BURST=20


# ── Base de datos — PostgreSQL (Supabase) ───────────────────────────
# Local:    postgresql+asyncpg://postgres:postgres@localhost:5432/shieldflow
# Supabase: postgresql+asyncpg://postgres.PROYECTO:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Nota: el prefijo postgresql+asyncpg:// es obligatorio (no postgresql://)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shieldflow


# ── WAF — Firewall de aplicación web ───────────────────────────────
# Activa o desactiva toda la inspección de peticiones
WAF_ENABLED=true

# Si es true, guarda en la base de datos cada intento bloqueado
WAF_LOG_BLOCKED=true

# IPs que saltan el WAF completamente (separadas por coma, sin espacios)
# Útil para health checks internos, sistemas de monitoreo, etc.
WAF_WHITELIST_IPS=127.0.0.1,::1


# ── CORS — Orígenes permitidos ──────────────────────────────────────
# Qué frontends pueden hacer peticiones a esta API
# En producción pon solo tus dominios reales, nunca *
CORS_ORIGINS=http://localhost:3000,http://localhost:8080


# ── Logging ─────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
# En desarrollo usa INFO o DEBUG. En producción, WARNING o ERROR
LOG_LEVEL=INFO

# "json" → para producción/Datadog/Grafana (estructurado)
# "console" → para desarrollo local (más legible)
LOG_FORMAT=console
